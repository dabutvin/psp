# Park Slope Parents Server Configuration
# Copy this file to .env and fill in your values

# Groups.io API credentials
GROUPS_IO_API_TOKEN=your_api_token_here
GROUPS_IO_GROUP_ID=8407

# PostgreSQL database connection (matches docker-compose.yml)
DATABASE_URL=postgresql://psp:psp@localhost:5432/psp

# Backfill configuration (seconds between requests)
BACKFILL_DELAY_SECONDS=5

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# APNs Push Notifications (optional - leave blank to disable)
# Get these from Apple Developer Portal → Certificates, Identifiers & Profiles → Keys
APNS_KEY_ID=          # 10-character key ID
APNS_TEAM_ID=         # 10-character team ID
APNS_BUNDLE_ID=       # App bundle ID (e.g., com.psp.classifieds)
APNS_KEY_PATH=        # Path to .p8 key file (for local dev)
# APNS_KEY_CONTENT=   # Or paste the .p8 key content here (for Fly.io secrets)
